---
# Keep CI focused on correctness, security, and resource misuse. Legacy
# modernization and readability migrations belong in separate cleanup work.
Checks: '-*,bugprone-*,cert-*,misc-*,performance-inefficient-algorithm,performance-inefficient-vector-operation'
HeaderFilterRegex: '(^|/)(apps|bridge|cpp|platforms|tools)/'
ExcludeHeaderFilterRegex: '(^|/)(cpp/external|cpp/plugins/cubism)/'
FormatStyle: file
WarningsAsErrors: ''
